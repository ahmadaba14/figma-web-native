<Window x:Class="FigmaShell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tabs="clr-namespace:FigmaShell.Tabs"
        Title="Figma"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="1440" Height="900"
        MinWidth="640" MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E"
        UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <!-- 1px bottom glass keeps the DWM drop shadow + Win11 rounded corners without native caption buttons -->
        <WindowChrome CaptionHeight="36"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0,0,0,1"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="TitleRow" Height="36" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Title bar: tabs + caption buttons. Empty space drags the window. -->
        <Grid Grid.Row="0" Background="#1E1E1E">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <tabs:TabStrip x:Name="Strip" Grid.Column="0" Margin="4,0,0,0" />

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                <Button x:Name="MinButton" Style="{StaticResource CaptionButton}"
                        Content="&#xE921;" ToolTip="Minimize" Click="MinButton_Click" />
                <!-- Clicks/hover for this one are handled via WM_NCHITTEST so Win11 snap layouts work -->
                <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}"
                        Content="&#xE922;" />
                <Button x:Name="CloseButton" Style="{StaticResource CloseCaptionButton}"
                        Content="&#xE8BB;" ToolTip="Close" Click="CloseButton_Click" />
            </StackPanel>
        </Grid>

        <!-- One WebView2 per tab lives here; only the active one is visible. -->
        <Grid x:Name="ContentHost" Grid.Row="1" Background="#2C2C2C" />
    </Grid>
</Window>
