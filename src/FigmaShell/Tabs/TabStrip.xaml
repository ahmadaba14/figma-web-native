<UserControl x:Class="FigmaShell.Tabs.TabStrip"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:FigmaShell.Tabs">
    <UserControl.Resources>
        <ContextMenu x:Key="NewMenu" Style="{StaticResource DarkMenu}" Placement="Bottom" Closed="NewMenu_Closed">
            <MenuItem Header="New design file" Tag="&#xE790;" InputGestureText="Ctrl+N" Click="NewDesign_Click" />
            <MenuItem Header="New FigJam board" Tag="&#xE70B;" Click="NewBoard_Click" />
            <MenuItem Header="New Slides deck" Tag="&#xE786;" Click="NewSlides_Click" />
            <Separator Style="{StaticResource MenuSeparator}" />
            <MenuItem Header="Open existing file…" Tag="&#xE838;" InputGestureText="Ctrl+T" Click="OpenExisting_Click" />
        </ContextMenu>
    </UserControl.Resources>
    <DockPanel LastChildFill="False">
        <ItemsControl x:Name="Items"
                      DockPanel.Dock="Left"
                      Focusable="False"
                      WindowChrome.IsHitTestVisibleInChrome="True"
                      MouseMove="Items_MouseMove"
                      MouseLeftButtonUp="Items_MouseLeftButtonUp"
                      LostMouseCapture="Items_LostMouseCapture">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <local:TabPanel ReservedWidth="96" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type local:TabItemModel}">
                    <Border x:Name="TabBorder"
                            Height="30" Margin="2,6,2,0" Padding="10,0,4,0"
                            CornerRadius="6,6,0,0"
                            Background="Transparent"
                            ToolTip="{Binding Title}"
                            MouseLeftButtonDown="Tab_MouseLeftButtonDown"
                            MouseUp="Tab_MouseUp">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Grid x:Name="IconHost" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Image x:Name="Icon" Source="{Binding Favicon}"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                <Path x:Name="Spinner" Width="16" Height="16"
                                      Data="M 8,1 A 7,7 0 0 1 15,8"
                                      Stroke="#0D99FF" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      RenderTransformOrigin="0.5,0.5"
                                      Visibility="Collapsed">
                                    <Path.RenderTransform>
                                        <RotateTransform />
                                    </Path.RenderTransform>
                                </Path>
                            </Grid>

                            <!-- Icon-only content for the pinned Home / Community tabs -->
                            <TextBlock x:Name="PinnedGlyph" Grid.ColumnSpan="3"
                                       Text="{Binding Glyph}"
                                       FontFamily="{StaticResource IconFont}"
                                       FontSize="14"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="#99FFFFFF"
                                       Visibility="Collapsed" />

                            <TextBlock x:Name="TitleText" Grid.Column="1"
                                       Text="{Binding Title}"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       Foreground="#99FFFFFF" />

                            <Button x:Name="CloseTab" Grid.Column="2"
                                    Style="{StaticResource TabCloseButton}"
                                    ToolTip="Close tab (Ctrl+W)"
                                    Click="Close_Click" />
                        </Grid>
                    </Border>

                    <DataTemplate.Triggers>
                        <Trigger SourceName="TabBorder" Property="IsMouseOver" Value="True">
                            <Setter TargetName="TabBorder" Property="Background" Value="#262626" />
                            <Setter TargetName="TitleText" Property="Foreground" Value="#CCFFFFFF" />
                        </Trigger>
                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                            <Setter TargetName="TabBorder" Property="Background" Value="#2C2C2C" />
                            <Setter TargetName="TitleText" Property="Foreground" Value="#FFFFFFFF" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsSuspended}" Value="True">
                            <Setter TargetName="Icon" Property="Opacity" Value="0.45" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsLoading}" Value="True">
                            <Setter TargetName="Spinner" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard x:Name="Spin">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Spinner"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                         From="0" To="360" Duration="0:0:0.8"
                                                         RepeatBehavior="Forever" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="Spin" />
                            </DataTrigger.ExitActions>
                        </DataTrigger>

                        <!-- Pinned tabs: icon only, no title / favicon / close button. Declared last so it wins. -->
                        <DataTrigger Binding="{Binding IsPinned}" Value="True">
                            <Setter TargetName="TabBorder" Property="Padding" Value="0" />
                            <Setter TargetName="TabBorder" Property="ToolTip" Value="{Binding PinnedLabel}" />
                            <Setter TargetName="PinnedGlyph" Property="Visibility" Value="Visible" />
                            <Setter TargetName="IconHost" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="TitleText" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="CloseTab" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsPinned}" Value="True" />
                                <Condition Binding="{Binding IsActive}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="PinnedGlyph" Property="Foreground" Value="#FFFFFFFF" />
                        </MultiDataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Button x:Name="NewTabButton"
                DockPanel.Dock="Left"
                Style="{StaticResource StripIconButton}"
                Content="&#xE710;"
                Margin="4,4,0,0"
                ToolTip="New or open file"
                AutomationProperties.Name="New or open file"
                WindowChrome.IsHitTestVisibleInChrome="True"
                Click="NewTab_Click" />
    </DockPanel>
</UserControl>
